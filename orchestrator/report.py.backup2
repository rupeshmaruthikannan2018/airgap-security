import json
from pathlib import Path
from html import escape


# ============================================================
# SEVERITY
# ============================================================

def severity_class(severity):
    severity = (severity or "UNKNOWN").upper()

    if severity in ["CRITICAL", "HIGH", "ERROR"]:
        return "high"

    if severity in ["MEDIUM", "WARNING"]:
        return "medium"

    if severity in ["LOW", "INFO"]:
        return "low"

    return "unknown"


def normalize_severity(severity):
    severity = (severity or "UNKNOWN").upper()

    if severity == "ERROR":
        return "HIGH"

    if severity == "WARNING":
        return "MEDIUM"

    if severity not in [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
    ]:
        return "UNKNOWN"

    return severity


# ============================================================
# HTML HELPERS
# ============================================================

def safe_text(value, default="N/A"):
    if value is None:
        return default

    if isinstance(value, bool):
        return str(value)

    if isinstance(value, (dict, list)):
        return escape(
            json.dumps(
                value,
                indent=2,
                ensure_ascii=False
            )
        )

    return escape(str(value))


def render_list(items, empty_text="No information available."):
    if not items:
        return f'<p class="muted">{escape(empty_text)}</p>'

    html = "<ul>"

    for item in items:
        if isinstance(item, dict):
            html += "<li>"

            for key, value in item.items():
                html += (
                    f"<b>{escape(str(key))}:</b> "
                    f"{safe_text(value)}<br>"
                )

            html += "</li>"

        else:
            html += f"<li>{safe_text(item)}</li>"

    html += "</ul>"

    return html


def status_class(status):
    value = str(status or "").upper()

    if value in [
        "CONFIRMED",
        "CONFIRMED_TRUE",
        "SATISFIED",
        "SUCCESSFUL",
        "PASS",
        "PASSED",
        "PATCHED",
        "MITIGATED",
        "NOT_SATISFIED"
    ]:
        if value == "NOT_SATISFIED":
            return "status-neutral"

        return "status-success"

    if value in [
        "NOT_PATCHED",
        "UNSUCCESSFUL",
        "FAILED",
        "FAIL",
        "REJECTED"
    ]:
        return "status-danger"

    if value in [
        "UNKNOWN",
        "NEEDS_REVIEW",
        "PENDING"
    ]:
        return "status-warning"

    return "status-neutral"


def status_badge(status):
    if status is None:
        status = "UNKNOWN"

    display = str(status).replace("_", " ").upper()

    css = status_class(status)

    return (
        f'<span class="status-badge {css}">'
        f'{escape(display)}'
        f'</span>'
    )


# ============================================================
# AI ASSESSMENT
# ============================================================

def render_ai_assessment(finding):
    """
    Render the traditional AI assessment generated by ai_analyzer.py.

    Expected structure:

    finding["ai_analysis"]["ai_assessment"]
    """

    analysis = finding.get("ai_analysis")

    if not isinstance(analysis, dict):
        return ""

    assessment = analysis.get("ai_assessment")

    if not isinstance(assessment, dict):
        return ""

    validity = assessment.get(
        "validity",
        "needs_review"
    )

    risk = assessment.get(
        "risk",
        "UNKNOWN"
    )

    confidence = assessment.get(
        "confidence",
        "UNKNOWN"
    )

    vulnerability_type = assessment.get(
        "vulnerability_type",
        "N/A"
    )

    evidence = assessment.get(
        "evidence",
        []
    )

    explanation = assessment.get(
        "explanation",
        ""
    )

    impact = assessment.get(
        "impact",
        ""
    )

    attack_path = assessment.get(
        "attack_path",
        []
    )

    recommended_fix = assessment.get(
        "recommended_fix",
        ""
    )

    patch_required = assessment.get(
        "patch_required"
    )

    return f"""
    <section class="section ai-section">

        <div class="section-title">
            <span class="section-icon">AI</span>
            <span>AI Security Assessment</span>
        </div>

        <div class="status-grid">

            <div class="status-card">
                <div class="label">
                    Validity
                </div>

                <div>
                    {status_badge(validity)}
                </div>
            </div>

            <div class="status-card">
                <div class="label">
                    AI Risk
                </div>

                <div>
                    {status_badge(risk)}
                </div>
            </div>

            <div class="status-card">
                <div class="label">
                    Confidence
                </div>

                <div>
                    {status_badge(confidence)}
                </div>
            </div>

            <div class="status-card">
                <div class="label">
                    Patch Required
                </div>

                <div>
                    {status_badge(
                        "YES"
                        if patch_required is True
                        else "NO"
                        if patch_required is False
                        else "UNKNOWN"
                    )}
                </div>
            </div>

        </div>


        <div class="content-block">

            <h4>Vulnerability Type</h4>

            <p>
                {safe_text(vulnerability_type)}
            </p>

        </div>


        <div class="content-block">

            <h4>Evidence</h4>

            {render_list(
                evidence,
                "No AI evidence supplied."
            )}

        </div>


        <div class="content-block">

            <h4>Explanation</h4>

            <p>
                {safe_text(
                    explanation,
                    "No explanation supplied."
                )}
            </p>

        </div>


        <div class="content-block">

            <h4>Impact</h4>

            <p>
                {safe_text(
                    impact,
                    "No impact assessment supplied."
                )}
            </p>

        </div>


        <div class="content-block">

            <h4>Attack Path</h4>

            {render_list(
                attack_path,
                "No concrete attack path was established from the supplied evidence."
            )}

        </div>


        <div class="content-block remediation-block">

            <h4>Recommended Fix</h4>

            <p>
                {safe_text(
                    recommended_fix,
                    "No remediation recommendation supplied."
                )}
            </p>

        </div>

    </section>
    """


# ============================================================
# CONTEXTUAL REMEDIATION ASSESSMENT
# ============================================================

def render_condition(condition):
    """
    Render one CVE condition.

    Supports structures such as:

    {
        "condition": "...",
        "status": "CONFIRMED",
        "reason": "..."
    }

    or:

    {
        "name": "...",
        "status": "...",
        "reason": "..."
    }
    """

    if not isinstance(condition, dict):
        return f"""
        <div class="condition-row">
            <div>
                {safe_text(condition)}
            </div>
        </div>
        """

    name = (
        condition.get("condition")
        or condition.get("name")
        or condition.get("id")
        or "Condition"
    )

    status = condition.get(
        "status",
        "UNKNOWN"
    )

    reason = condition.get(
        "reason"
    )

    return f"""
    <div class="condition-row">

        <div class="condition-main">

            <div class="condition-name">
                {safe_text(name)}
            </div>

            {
                f'<div class="condition-reason">'
                f'{safe_text(reason)}'
                f'</div>'
                if reason
                else ""
            }

        </div>

        <div>
            {status_badge(status)}
        </div>

    </div>
    """


def render_conditions(conditions):
    if not conditions:
        return """
        <p class="muted">
            No detailed CVE conditions were supplied.
        </p>
        """

    html = '<div class="conditions">'

    for condition in conditions:
        html += render_condition(condition)

    html += "</div>"

    return html


def render_assessment_block(title, assessment):
    """
    Render structures such as:

    {
        "status": "NOT_SATISFIED",
        "reason": "..."
    }
    """

    if not isinstance(assessment, dict):
        return ""

    status = assessment.get(
        "status",
        "UNKNOWN"
    )

    reason = assessment.get(
        "reason",
        ""
    )

    return f"""
    <div class="assessment-card">

        <div class="assessment-header">

            <h4>
                {escape(title)}
            </h4>

            {status_badge(status)}

        </div>

        <p>
            {safe_text(
                reason,
                "No explanation supplied."
            )}
        </p>

    </div>
    """


def render_remediation_actions(actions):
    if not actions:
        return """
        <p class="muted">
            No structured remediation actions were supplied.
        </p>
        """

    html = '<div class="remediation-actions">'

    for index, action in enumerate(actions, start=1):

        if isinstance(action, dict):

            action_text = (
                action.get("action")
                or action.get("description")
                or action.get("step")
                or ""
            )

            reason = action.get(
                "reason"
            )

            action_type = action.get(
                "type"
            )

            html += f"""
            <div class="remediation-action">

                <div class="action-number">
                    {index}
                </div>

                <div class="action-content">

                    <h4>
                        {safe_text(
                            action_text,
                            "Remediation action"
                        )}
                    </h4>
            """

            if action_type:
                html += f"""
                    <div class="action-type">
                        Type:
                        <b>{safe_text(action_type)}</b>
                    </div>
                """

            if reason:
                html += f"""
                    <p>
                        {safe_text(reason)}
                    </p>
                """

            html += """
                </div>

            </div>
            """

        else:

            html += f"""
            <div class="remediation-action">

                <div class="action-number">
                    {index}
                </div>

                <div class="action-content">

                    <p>
                        {safe_text(action)}
                    </p>

                </div>

            </div>
            """

    html += "</div>"

    return html


def render_contextual_remediation(finding):
    """
    Render newer context-aware remediation results.

    Supported sources:

    finding["remediation_assessment"]

    OR

    finding["remediation_analysis"]

    OR

    finding["llm_assessment"]

    The function intentionally supports multiple names so
    older and newer pipeline artifacts can coexist.
    """

    assessment = (
        finding.get("remediation_assessment")
        or finding.get("remediation_analysis")
        or finding.get("llm_assessment")
    )

    if not isinstance(assessment, dict):
        return ""

    # Some saved results wrap the actual assessment.
    if isinstance(
        assessment.get("llm_assessment"),
        dict
    ):
        assessment = assessment["llm_assessment"]

    if isinstance(
        assessment.get("assessment"),
        dict
    ):
        assessment = assessment["assessment"]

    # --------------------------------------------------------
    # Determine whether this is actually a contextual result.
    # --------------------------------------------------------

    contextual_keys = {
        "applicability",
        "conditions",
        "rce_assessment",
        "information_disclosure_assessment",
        "root_cause",
        "remediation",
        "validation",
        "configuration_mitigation",
        "behavioral_validation",
        "software_patch",
        "remediation_assessment"
    }

    if not any(
        key in assessment
        for key in contextual_keys
    ):
        return ""

    # --------------------------------------------------------
    # Basic fields
    # --------------------------------------------------------

    overall = assessment.get(
        "remediation_assessment"
    )

    if not isinstance(overall, str):
        overall = assessment.get(
            "overall_status"
        )

    if not isinstance(overall, str):
        overall = assessment.get(
            "status"
        )

    applicability = assessment.get(
        "applicability"
    )

    if isinstance(applicability, dict):
        applicability_status = applicability.get(
            "status",
            "UNKNOWN"
        )

        applicability_reason = applicability.get(
            "reason",
            ""
        )
    else:
        applicability_status = (
            applicability
            if applicability
            else "UNKNOWN"
        )

        applicability_reason = ""

    risk = assessment.get(
        "risk",
        "UNKNOWN"
    )

    confidence = assessment.get(
        "confidence",
        "UNKNOWN"
    )

    root_cause = assessment.get(
        "root_cause"
    )

    conditions = assessment.get(
        "conditions",
        []
    )

    rce_assessment = assessment.get(
        "rce_assessment"
    )

    information_disclosure = assessment.get(
        "information_disclosure_assessment"
    )

    remediation = assessment.get(
        "remediation",
        []
    )

    validation = assessment.get(
        "validation",
        []
    )

    configuration_mitigation = assessment.get(
        "configuration_mitigation"
    )

    behavioral_validation = assessment.get(
        "behavioral_validation"
    )

    software_patch = assessment.get(
        "software_patch"
    )

    final_reasoning = assessment.get(
        "final_reasoning"
    )

    remaining_conditions = assessment.get(
        "remaining_conditions",
        []
    )

    return f"""
    <section class="section contextual-section">

        <div class="section-title">
            <span class="section-icon">LLM</span>
            <span>Context-Aware Security Assessment</span>
        </div>


        <div class="notice">

            <b>Important:</b>

            This section represents the local LLM's
            contextual interpretation of the supplied evidence.
            Scanner findings remain the primary source for
            scanner facts.
        </div>


        <div class="status-grid">

            <div class="status-card">

                <div class="label">
                    Applicability
                </div>

                <div>
                    {status_badge(
                        applicability_status
                    )}
                </div>

                {
                    f'<p class="small-text">'
                    f'{safe_text(applicability_reason)}'
                    f'</p>'
                    if applicability_reason
                    else ""
                }

            </div>


            <div class="status-card">

                <div class="label">
                    LLM Risk
                </div>

                <div>
                    {status_badge(risk)}
                </div>

            </div>


            <div class="status-card">

                <div class="label">
                    Confidence
                </div>

                <div>
                    {status_badge(confidence)}
                </div>

            </div>


            {
                f'''
                <div class="status-card">

                    <div class="label">
                        Overall Assessment
                    </div>

                    <div>
                        {status_badge(overall)}
                    </div>

                </div>
                '''
                if overall
                else ""
            }

        </div>


        {
            f'''
            <div class="content-block">

                <h4>Root Cause</h4>

                <p>
                    {safe_text(root_cause)}
                </p>

            </div>
            '''
            if root_cause
            else ""
        }


        <div class="content-block">

            <h4>Condition Analysis</h4>

            {render_conditions(conditions)}

        </div>


        <div class="assessment-grid">

            {
                render_assessment_block(
                    "Remote Code Execution",
                    rce_assessment
                )
                if rce_assessment
                else ""
            }

            {
                render_assessment_block(
                    "Information Disclosure / Content Injection",
                    information_disclosure
                )
                if information_disclosure
                else ""
            }

        </div>


        {
            f'''
            <div class="content-block">

                <h4>Configuration Mitigation</h4>

                {render_assessment_block(
                    "Configuration Mitigation",
                    configuration_mitigation
                )}

            </div>
            '''
            if configuration_mitigation
            else ""
        }


        {
            f'''
            <div class="content-block">

                <h4>Behavioral Validation</h4>

                {render_assessment_block(
                    "Behavioral Validation",
                    behavioral_validation
                )}

            </div>
            '''
            if behavioral_validation
            else ""
        }


        {
            f'''
            <div class="content-block">

                <h4>Software Patch Status</h4>

                {render_assessment_block(
                    "Software Patch",
                    software_patch
                )}

            </div>
            '''
            if software_patch
            else ""
        }


        <div class="content-block remediation-block">

            <h4>Recommended Remediation</h4>

            {render_remediation_actions(
                remediation
            )}

        </div>


        {
            f'''
            <div class="content-block">

                <h4>Validation Plan</h4>

                {render_list(
                    validation,
                    "No validation steps supplied."
                )}

            </div>
            '''
            if validation
            else ""
        }


        {
            f'''
            <div class="content-block">

                <h4>Remaining / Unknown Conditions</h4>

                {render_list(
                    remaining_conditions,
                    "No remaining conditions were reported."
                )}

            </div>
            '''
            if remaining_conditions
            else ""
        }


        {
            f'''
            <div class="content-block final-reasoning">

                <h4>LLM Final Reasoning</h4>

                <p>
                    {safe_text(final_reasoning)}
                </p>

            </div>
            '''
            if final_reasoning
            else ""
        }

    </section>
    """


# ============================================================
# REMEDIATION / VALIDATION RESULT
# ============================================================

def render_validation_result(finding):
    """
    Render independent remediation validation when available.

    Expected structure can be attached as:

    finding["remediation_validation"]
    """

    validation = finding.get(
        "remediation_validation"
    )

    if not isinstance(validation, dict):
        return ""

    overall_status = validation.get(
        "overall_status"
        or "status"
    )

    configuration = validation.get(
        "configuration_validation"
    )

    behavioral = validation.get(
        "behavioral_validation"
    )

    service = validation.get(
        "service_validation"
    )

    version_status = validation.get(
        "version_patch_status"
    )

    return f"""
    <section class="section validation-section">

        <div class="section-title">
            <span class="section-icon">✓</span>
            <span>Independent Remediation Validation</span>
        </div>


        <div class="status-grid">

            <div class="status-card">

                <div class="label">
                    Overall
                </div>

                <div>
                    {status_badge(
                        overall_status
                        or "UNKNOWN"
                    )}
                </div>

            </div>


            {
                f'''
                <div class="status-card">

                    <div class="label">
                        Configuration
                    </div>

                    <div>
                        {status_badge(configuration)}
                    </div>

                </div>
                '''
                if configuration is not None
                else ""
            }


            {
                f'''
                <div class="status-card">

                    <div class="label">
                        Behavior
                    </div>

                    <div>
                        {status_badge(behavioral)}
                    </div>

                </div>
                '''
                if behavioral is not None
                else ""
            }


            {
                f'''
                <div class="status-card">

                    <div class="label">
                        Service
                    </div>

                    <div>
                        {status_badge(service)}
                    </div>

                </div>
                '''
                if service is not None
                else ""
            }


            {
                f'''
                <div class="status-card">

                    <div class="label">
                        Software Version
                    </div>

                    <div>
                        {status_badge(version_status)}
                    </div>

                </div>
                '''
                if version_status is not None
                else ""
            }

        </div>

        <div class="content-block">

            <h4>Validation Evidence</h4>

            <pre>{safe_text(validation)}</pre>

        </div>

    </section>
    """


# ============================================================
# FINDING CARD
# ============================================================

def render_finding(finding):

    raw_severity = (
        finding.get("severity")
        or "UNKNOWN"
    )

    display_severity = normalize_severity(
        raw_severity
    )

    css_class = severity_class(
        display_severity
    )

    finding_id = safe_text(
        finding.get("id", "")
    )

    title = safe_text(
        finding.get(
            "title",
            "Unknown vulnerability"
        )
    )

    scanner = safe_text(
        finding.get(
            "scanner",
            "unknown"
        )
    )

    finding_type = safe_text(
        finding.get(
            "type",
            "N/A"
        )
    )

    file_path = safe_text(
        finding.get(
            "file",
            ""
        )
    )

    cwe = safe_text(
        finding.get(
            "cwe"
        )
        or "N/A"
    )

    description = safe_text(
        finding.get(
            "description",
            ""
        )
    )

    line_start = finding.get(
        "line_start"
    )

    line_end = finding.get(
        "line_end"
    )

    if line_start and line_end:
        location = (
            f"Lines {line_start}-{line_end}"
        )

    elif line_start:
        location = (
            f"Line {line_start}"
        )

    else:
        location = "Location unavailable"

    code_context = finding.get(
        "code_context"
    )

    if code_context:
        code_html = escape(
            str(code_context)
        )
    else:
        code_html = (
            "No source-code context available."
        )

    related = finding.get(
        "related_findings",
        []
    )

    if not isinstance(
        related,
        list
    ):
        related = [related]

    related_text = ", ".join(
        str(item)
        for item in related
    )

    # --------------------------------------------------------
    # Optional CVE metadata
    # --------------------------------------------------------

    cve = finding.get(
        "cve"
    )

    package = finding.get(
        "package"
    )

    installed_version = finding.get(
        "installed_version"
    )

    fixed_version = finding.get(
        "fixed_version"
    )

    cve_metadata = ""

    if any([
        cve,
        package,
        installed_version,
        fixed_version
    ]):

        cve_metadata = f"""
        <div class="metadata-panel">

            {
                f'''
                <div>
                    <span class="metadata-label">
                        CVE
                    </span>

                    <span>
                        {safe_text(cve)}
                    </span>
                </div>
                '''
                if cve
                else ""
            }


            {
                f'''
                <div>
                    <span class="metadata-label">
                        Package
                    </span>

                    <span>
                        {safe_text(package)}
                    </span>
                </div>
                '''
                if package
                else ""
            }


            {
                f'''
                <div>
                    <span class="metadata-label">
                        Installed
                    </span>

                    <span>
                        {safe_text(installed_version)}
                    </span>
                </div>
                '''
                if installed_version
                else ""
            }


            {
                f'''
                <div>
                    <span class="metadata-label">
                        Fixed Version
                    </span>

                    <span>
                        {safe_text(fixed_version)}
                    </span>
                </div>
                '''
                if fixed_version
                else ""
            }

        </div>
        """

    return f"""
    <article class="finding">

        <div class="finding-header">

            <div>

                <span class="severity {css_class}">
                    {escape(display_severity)}
                </span>

                <span class="finding-id">
                    {finding_id}
                </span>

            </div>

            <span class="scanner-badge">
                {scanner}
            </span>

        </div>


        <h2>
            {title}
        </h2>


        <div class="metadata">

            <div>
                <b>Scanner:</b>
                {scanner}
            </div>

            <div>
                <b>Finding type:</b>
                {finding_type}
            </div>

            <div>
                <b>File:</b>
                {file_path}
            </div>

            <div>
                <b>Location:</b>
                {escape(location)}
            </div>

            <div>
                <b>CWE:</b>
                {cwe}
            </div>

        </div>


        {cve_metadata}


        <div class="description">

            <h3>
                Scanner Description
            </h3>

            <p>
                {description}
            </p>

        </div>


        <details class="source-details">

            <summary>
                View source / scanner context
            </summary>

            <pre>{code_html}</pre>

        </details>


        <div class="related">

            <b>
                Related scanner findings:
            </b>

            {
                escape(related_text)
                if related_text
                else "None"
            }

        </div>


        {render_ai_assessment(finding)}


        {render_contextual_remediation(finding)}


        {render_validation_result(finding)}

    </article>
    """


# ============================================================
# MAIN REPORT GENERATOR
# ============================================================

def generate_html_report(
    findings,
    application_name,
    output_file
):

    output_file = Path(
        output_file
    )

    output_file.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    counts = {
        "CRITICAL": 0,
        "HIGH": 0,
        "MEDIUM": 0,
        "LOW": 0,
        "UNKNOWN": 0
    }

    for finding in findings:

        severity = normalize_severity(
            finding.get("severity")
        )

        counts[severity] += 1

    finding_cards = []

    for finding in findings:
        finding_cards.append(
            render_finding(
                finding
            )
        )

    # --------------------------------------------------------
    # Report HTML
    # --------------------------------------------------------

    html = f"""
<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>
    Air-Gapped AI Security Report
</title>

<style>

/* ==========================================================
   GLOBAL
   ========================================================== */

* {{
    box-sizing: border-box;
}}

body {{

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    background:
        #f4f6f8;

    color:
        #202124;

    margin:
        0;

    padding:
        30px;

    line-height:
        1.55;
}}

.container {{

    max-width:
        1200px;

    margin:
        auto;
}}


/* ==========================================================
   HEADER
   ========================================================== */

.header {{

    background:
        white;

    padding:
