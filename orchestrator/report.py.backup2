    border-radius:
        14px;

    margin-bottom:
        22px;

    border:
        1px solid #e1e5e9;

    box-shadow:
        0 2px 8px rgba(
            0,
            0,
            0,
            0.04
        );
}}

.header h1 {{

    margin:
        0 0 8px 0;

    font-size:
