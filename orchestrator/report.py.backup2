</style>

</head>


<body>

<div class="container">


    <div class="header">

        <h1>
            Air-Gapped AI Security Report
        </h1>

        <p>
            <b>Application:</b>
            {escape(str(application_name))}
        </p>

        <p>
            <b>Total unique findings:</b>
            {len(findings)}
        </p>

        <p>
            Scanner evidence is displayed separately from
            AI interpretation and remediation validation.
        </p>

    </div>


    <div class="stats">

        <div class="stat">

            <div class="stat-number">
                {counts["CRITICAL"]}
            </div>

            <div>
                Critical
            </div>

        </div>


        <div class="stat">

            <div class="stat-number">
                {counts["HIGH"]}
            </div>

            <div>
                High
            </div>

        </div>


        <div class="stat">

            <div class="stat-number">
                {counts["MEDIUM"]}
            </div>

            <div>
                Medium
            </div>

        </div>


        <div class="stat">

            <div class="stat-number">
                {counts["LOW"]}
            </div>

            <div>
                Low
            </div>

        </div>


        <div class="stat">

            <div class="stat-number">
                {counts["UNKNOWN"]}
            </div>

            <div>
                Unknown
            </div>

        </div>

    </div>


    {''.join(finding_cards)}


</div>

</body>

</html>
"""

    with open(
        output_file,
        "w",
        encoding="utf-8"
    ) as f:

        f.write(html)

    return output_file


# ============================================================
# PROTOTYPE REPORT ENHANCEMENTS
# ============================================================
# Automatically discovers contextual sidecar files and renders
# deterministic environment conditions separately from LLM reasoning.


def _prototype_load_json(path):
    try:
        path = Path(path)
        if not path.exists():
            return None
        with open(path, 'r', encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return None


def _prototype_contextual_assessment(obj):
    if isinstance(obj, dict):
        strong = {
            'applicability', 'conditions', 'rce_assessment',
            'information_disclosure_assessment', 'root_cause',
            'validation', 'unknowns'
        }
        if len(strong.intersection(obj.keys())) >= 2:
            return obj

        for key in [
            'remediation_assessment', 'remediation_analysis',
            'llm_assessment', 'assessment', 'result', 'analysis', 'data'
        ]:
            if key in obj:
                found = _prototype_contextual_assessment(obj[key])
                if found is not None:
                    return found

        for value in obj.values():
            found = _prototype_contextual_assessment(value)
            if found is not None:
                return found

    elif isinstance(obj, list):
        for value in obj:
            found = _prototype_contextual_assessment(value)
            if found is not None:
                return found

    return None


def _prototype_condition_records(obj, records=None):
    if records is None:
        records = []

    if isinstance(obj, dict):
        is_condition = (
            ('condition' in obj or 'name' in obj or 'condition_id' in obj)
            and 'status' in obj
        )

        if is_condition:
            evidence = (
                obj.get('selected_evidence')
                or obj.get('evidence')
                or obj.get('all_evidence')
            )
            records.append({
                'name': (
                    obj.get('condition')
                    or obj.get('name')
                    or obj.get('condition_id')
                    or 'Condition'
                ),
                'status': obj.get('status', 'UNKNOWN'),
                'reason': obj.get('reason') or obj.get('description') or '',
                'evidence': evidence,
                'required': (
                    obj.get('required_value')
                    if 'required_value' in obj
                    else obj.get('required')
                )
            })

        for value in obj.values():
            _prototype_condition_records(value, records)

    elif isinstance(obj, list):
        for value in obj:
            _prototype_condition_records(value, records)

    unique = []
    seen = set()
    for record in records:
        key = (
            str(record.get('name')),
            str(record.get('status')),
            json.dumps(record.get('evidence'), sort_keys=True, default=str)
        )
        if key not in seen:
            seen.add(key)
            unique.append(record)
    return unique


def _prototype_group_statuses(obj, groups=None):
    if groups is None:
        groups = []

    if isinstance(obj, dict):
        for key, value in obj.items():
            if isinstance(value, dict):
                status = value.get('overall_status') or value.get('status')
                lowered = str(key).lower()
                if status and any(
                    x in lowered for x in [
                        'remote_code_execution',
                        'information_disclosure',
                        'content_injection'
                    ]
                ):
                    groups.append((key, status, value.get('reason', '')))
                _prototype_group_statuses(value, groups)
            elif isinstance(value, list):
                _prototype_group_statuses(value, groups)

    elif isinstance(obj, list):
        for value in obj:
            _prototype_group_statuses(value, groups)

    return groups


def _prototype_render_evidence(value):
    if value is None:
        return '<span class="muted">No evidence</span>'

    if isinstance(value, dict):
        path = value.get('path')
        actual_value = value.get('value')
        evidence_status = value.get('status')
        parts = []

        if path:
            parts.append(f'<b>{safe_text(path)}</b>')
        if 'value' in value:
            parts.append(f'Value: {safe_text(actual_value)}')
        if evidence_status:
            parts.append(f'Evidence: {status_badge(evidence_status)}')
        if parts:
            return '<br>'.join(parts)

    return safe_text(value)


def _prototype_render_deterministic_evaluation(evaluation):
    if not evaluation:
        return ''

    records = _prototype_condition_records(evaluation)
    groups = _prototype_group_statuses(evaluation)

    if not records and not groups:
        return ''

    html = '''
    <section class="deterministic-evaluation">
        <div class="evaluation-banner">
            <b>Deterministic Environment Evaluation</b>
            <span>
                These statuses are calculated from collected environment
                evidence before LLM remediation reasoning.
            </span>
        </div>
    '''

    if groups:
        html += '<div class="assessment-grid evaluator-groups">'
        for name, status, reason in groups:
            title = str(name).replace('_', ' ').title()
            html += f'''
            <div class="assessment-card">
                <div class="assessment-header">
                    <h4>{escape(title)}</h4>
                    {status_badge(status)}
                </div>
                {f"<p>{safe_text(reason)}</p>" if reason else ""}
            </div>
            '''
        html += '</div>'

    if records:
        html += '''
        <div class="condition-table-wrapper">
            <table class="condition-table">
                <thead>
                    <tr>
                        <th>Environmental Condition</th>
                        <th>Status</th>
                        <th>Required</th>
                        <th>Evidence</th>
                    </tr>
                </thead>
                <tbody>
        '''

        for record in records:
            reason_html = ''
            if record.get('reason'):
                reason_html = (
                    '<div class="small-text">'
                    + safe_text(record['reason'])
                    + '</div>'
                )

            required = record.get('required')
            required_html = (
                safe_text(required)
                if required is not None
                else '<span class="muted">N/A</span>'
            )

            html += f'''
                    <tr>
                        <td>
                            <b>{safe_text(record['name'])}</b>
                            {reason_html}
                        </td>
                        <td>{status_badge(record['status'])}</td>
                        <td>{required_html}</td>
                        <td>{_prototype_render_evidence(record['evidence'])}</td>
                    </tr>
            '''

        html += '''
                </tbody>
            </table>
        </div>
        '''

    html += '</section>'
    return html


def _prototype_load_sidecars(output_file):
    base = Path(output_file).parent
    candidates = {
        'evaluation': [
            base / 'cve-evaluation.json',
            base / 'cve_evaluation.json',
            base / 'evaluation.json'
        ],
        'remediation': [
            base / 'remediation-analysis.json',
            base / 'remediation_analysis.json',
            base / 'remediation.json'
        ],
        'configuration': [
            base / 'tomcat-config.json',
            base / 'tomcat_config.json',
            base / 'configuration.json'
        ],
        'validation': [
            base / 'remediation-validation-after.json',
            base / 'remediation-validation.json',
            base / 'validation.json'
        ]
    }

    loaded = {}
    for category, paths in candidates.items():
        loaded[category] = None
        for path in paths:
            data = _prototype_load_json(path)
            if data is not None:
                loaded[category] = data
                break
    return loaded


def _prototype_enrich_finding(finding, sidecars):
    enriched = dict(finding)

    if sidecars.get('evaluation') is not None:
        enriched.setdefault('cve_evaluation', sidecars['evaluation'])

    if sidecars.get('remediation') is not None:
        enriched.setdefault('remediation_analysis', sidecars['remediation'])

    if sidecars.get('configuration') is not None:
        enriched.setdefault(
            'environment_configuration',
            sidecars['configuration']
        )

    if sidecars.get('validation') is not None:
        enriched.setdefault(
            'remediation_validation',
            sidecars['validation']
        )

    return enriched


# Override contextual rendering so deterministic evaluator output is visible.
def render_contextual_remediation(finding):
    source = (
        finding.get('remediation_assessment')
        or finding.get('remediation_analysis')
        or finding.get('llm_assessment')
    )

    assessment = _prototype_contextual_assessment(source)

    evaluation = (
        finding.get('cve_evaluation')
        or finding.get('condition_evaluation')
        or finding.get('evaluation')
    )

    deterministic_html = _prototype_render_deterministic_evaluation(
        evaluation
    )

    if not isinstance(assessment, dict):
        if not deterministic_html:
            return ''
        return f'''
        <section class="section contextual-section">
            <div class="section-title">
                <span class="section-icon">CTX</span>
                <span>Context-Aware Security Assessment</span>
            </div>
            {deterministic_html}
            <div class="notice">
                No structured contextual LLM result was found.
            </div>
        </section>
        '''

    overall = (
        assessment.get('remediation_assessment')
        or assessment.get('overall_status')
        or assessment.get('status')
    )

    applicability = assessment.get('applicability')
    if isinstance(applicability, dict):
        applicability_status = applicability.get('status', 'UNKNOWN')
        applicability_reason = applicability.get('reason', '')
    else:
        applicability_status = applicability or 'UNKNOWN'
        applicability_reason = ''

    risk = assessment.get('risk', 'UNKNOWN')
    confidence = assessment.get('confidence', 'UNKNOWN')
    root_cause = assessment.get('root_cause')
    conditions = assessment.get('conditions', [])
    rce = assessment.get('rce_assessment')
    disclosure = assessment.get('information_disclosure_assessment')
    remediation = assessment.get('remediation', [])
    validation = assessment.get('validation', [])
    configuration_mitigation = assessment.get('configuration_mitigation')
    behavioral_validation = assessment.get('behavioral_validation')
    software_patch = assessment.get('software_patch')
    remaining_conditions = assessment.get('remaining_conditions', [])
    final_reasoning = assessment.get('final_reasoning')

    return f'''
    <section class="section contextual-section">

        <div class="section-title">
            <span class="section-icon">LLM</span>
            <span>Context-Aware Security Assessment</span>
        </div>

        <div class="notice">
            <b>Evidence-driven analysis:</b>
            deterministic condition evaluation is shown first. The LLM
            then reasons about remediation using those facts.
        </div>

        {deterministic_html}

        <div class="status-grid">
            <div class="status-card">
                <div class="label">Applicability</div>
                <div>{status_badge(applicability_status)}</div>
                {f'<p class="small-text">{safe_text(applicability_reason)}</p>' if applicability_reason else ''}
            </div>

            <div class="status-card">
                <div class="label">LLM Risk</div>
                <div>{status_badge(risk)}</div>
            </div>

            <div class="status-card">
                <div class="label">Confidence</div>
                <div>{status_badge(confidence)}</div>
            </div>

            {f'''
            <div class="status-card">
                <div class="label">Overall Assessment</div>
                <div>{status_badge(overall)}</div>
            </div>
            ''' if overall else ''}
        </div>

        {f'''
        <div class="content-block">
            <h4>Root Cause</h4>
            <p>{safe_text(root_cause)}</p>
        </div>
        ''' if root_cause else ''}

        {f'''
        <div class="content-block">
            <h4>LLM Condition Interpretation</h4>
            {render_conditions(conditions)}
        </div>
        ''' if conditions else ''}

        <div class="assessment-grid">
            {render_assessment_block('Remote Code Execution', rce) if rce else ''}
            {render_assessment_block('Information Disclosure / Content Injection', disclosure) if disclosure else ''}
        </div>

        {f'''
        <div class="content-block">
            <h4>Configuration Mitigation</h4>
            {render_assessment_block('Configuration Mitigation', configuration_mitigation)}
        </div>
        ''' if configuration_mitigation else ''}

        {f'''
        <div class="content-block">
            <h4>Behavioral Validation</h4>
            {render_assessment_block('Behavioral Validation', behavioral_validation)}
        </div>
        ''' if behavioral_validation else ''}

        {f'''
        <div class="content-block">
            <h4>Software Patch Status</h4>
            {render_assessment_block('Software Patch', software_patch)}
        </div>
        ''' if software_patch else ''}

        <div class="content-block remediation-block">
            <h4>Recommended Remediation</h4>
            {render_remediation_actions(remediation)}
        </div>

        {f'''
        <div class="content-block">
            <h4>Validation Plan</h4>
            {render_list(validation, 'No validation steps supplied.')}
        </div>
        ''' if validation else ''}

        {f'''
        <div class="content-block">
            <h4>Remaining / Unknown Conditions</h4>
            {render_list(remaining_conditions, 'No remaining conditions were reported.')}
        </div>
        ''' if remaining_conditions else ''}

        {f'''
        <div class="content-block final-reasoning">
            <h4>LLM Final Reasoning</h4>
            <p>{safe_text(final_reasoning)}</p>
        </div>
        ''' if final_reasoning else ''}

    </section>
    '''


# Preserve the original generator and wrap it with sidecar discovery.
_prototype_original_generate_html_report = generate_html_report


def generate_html_report(findings, application_name, output_file):
    sidecars = _prototype_load_sidecars(output_file)

    enriched = [
        _prototype_enrich_finding(finding, sidecars)
        for finding in findings
    ]

    return _prototype_original_generate_html_report(
        enriched,
        application_name,
        output_file
    )

